# ---------------------------------------------------------------------------
# VisionX Server Environment Template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#
# NOTE ON PRECEDENCE: an entry in this file overrides a variable of the same
# name that is already exported in the process environment. The server logs a
# warning when it overrides one, so a stale host variable can never silently
# shadow the value you just wrote here.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=production

# ---------------------------------------------------------------------------
# PostgreSQL
#
# Supabase (and every other IPv4-only host) MUST use the connection pooler.
# The direct host `db.<ref>.supabase.co` resolves to an IPv6-only record, so it
# is unreachable from a machine without IPv6.
#
#   session mode (5432)     ← use this: required for DDL and migrations
#   transaction mode (6543) ← lighter, but rejects multi-statement transactions
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# `scripts/connect-supabase.js <project-ref> <password>` prints the working
# string for your project; `scripts/inspect-db.js` verifies the result.
#
# Local PostgreSQL:  postgresql://vision_user:SecurePassword123!@localhost:5432/visionx_db
# ---------------------------------------------------------------------------
DATABASE_URL=
# require = always TLS (managed providers), disable = local socket/trusted LAN.
# Unset means TLS is enabled in production only.
DATABASE_SSL=require

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_byte_random_hex_string
JWT_EXPIRES_IN=24h

# Allowed browser origin(s) for credentialed CORS. Comma-separate for multiple.
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Google Gemini
#
# Leave GEMINI_API_KEY empty to start in Simulated Demo Mode, or supply a key
# at runtime from the in-app "Gemini API key" panel instead of writing it here.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when a model is capacity-blocked (503 "high demand").
# gemini-2.5-flash is gated for new projects, hence the 3.x chain.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
