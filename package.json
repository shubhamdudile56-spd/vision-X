{
  "name": "visionx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VisionX — Smart Visual Experience. Production-grade computer vision and visual intelligence platform.",
  "engines": {

    "node": ">=20.0.0"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/server.js",
    "preview": "npm run preview --prefix client",
    "migrate": "npm run migrate --prefix server",
    "smoke": "npm run smoke --prefix server",
    "lint": "npm run lint --prefix client"
  }
}
